{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/check_ready.py\" --hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(python3 *scripts/deploy.py*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/deploy_permission.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/chrome_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
