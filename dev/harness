#!/usr/bin/env python3
"""Maintainer CLI for the Weni harness plugin (not shipped: only plugin/ is).

    dev/harness test                 self-tests + plugin/marketplace validation
    dev/harness sandbox new <name>   empty project in ~/.harness-sandboxes using ./plugin
    dev/harness sandbox list|clean
    dev/harness release [kind]       cut a version from the CHANGELOG (local commit + tag)
"""

import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DEV = ROOT / "dev"


def python():
    """Prefer the repo .venv (has PyYAML) for scripts that need it."""
    venv_python = ROOT / ".venv" / "bin" / "python"
    return str(venv_python) if venv_python.exists() else sys.executable


def cmd_test(rest):
    code = subprocess.call([python(), "-m", "unittest", "discover", "-s", "dev/tests", *rest], cwd=str(ROOT))
    if shutil.which("claude") is None:
        print("skip: `claude` CLI not found, plugin validation not run")
        return code
    for target in ("plugin", "."):
        result = subprocess.run(["claude", "plugin", "validate", target], cwd=str(ROOT), capture_output=True, text=True)
        verdict = result.stdout.strip().splitlines()[-1] if result.stdout.strip() else result.stderr.strip()
        print(f"claude plugin validate {target}: {verdict}")
        code = code or result.returncode
    return code


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    command, rest = sys.argv[1], sys.argv[2:]
    if command == "test":
        return cmd_test(rest)
    if command == "sandbox":
        return subprocess.call([sys.executable, str(DEV / "sandbox.py"), *rest], cwd=str(ROOT))
    if command == "release":
        if cmd_test([]) != 0:
            print("Tests failed; not releasing.")
            return 1
        return subprocess.call([sys.executable, str(DEV / "release.py"), *rest], cwd=str(ROOT))
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main())
